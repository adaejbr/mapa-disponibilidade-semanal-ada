rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to the specific availability document
    // This maintains current app functionality while securing the database
    match /availability/agenda-disponibilidade-v1 {
      allow read, write: if true;
    }
    
    // Deny access to all other documents/collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}